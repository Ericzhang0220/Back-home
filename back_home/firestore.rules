rules_version = '2';

// Back Home security rules.
//
// Covers every collection the app touches today. Review this against your
// current console rules before deploying — deploying replaces them wholesale.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profiles are discoverable so the Human chats tab can list app users.
    // Only the owner can modify their own document.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Private mood journal.
      match /moodEntries/{entryId} {
        allow read, write: if isOwner(uid);
      }

      // Server-only bookkeeping (AI rate-limit counters). The Admin SDK
      // bypasses these rules, so closing it off here keeps clients from
      // reading or resetting their own quota.
      match /private/{docId} {
        allow read, write: if false;
      }

      // AI companion characters, preset and user-authored.
      match /aiCharacters/{characterId} {
        allow read, write: if isOwner(uid);
      }

      // The Human tab's friends list. Private to the owner — who is on it is
      // never visible to the people on it.
      match /humanFriends/{friendUid} {
        allow read, write: if isOwner(uid);
      }

      // One document per person ever added, feeding the profile's likes
      // counter. Never deleted by the app: unfriending must not refund a like.
      match /friendLikeAwards/{friendUid} {
        allow read, write: if isOwner(uid);
      }

      // Incoming friend requests, keyed by requester uid. Anyone may put a
      // request in someone else's inbox, but only under their own uid, so a
      // request can never be forged on another person's behalf. Only the
      // owner reads them; either side can clear one — the owner by
      // accepting or rejecting, the requester by withdrawing.
      match /friendRequests/{requesterUid} {
        allow read: if isOwner(uid);
        allow create: if signedIn() && request.auth.uid == requesterUid;
        allow update: if false;
        allow delete: if isOwner(uid) || request.auth.uid == requesterUid;
      }

      // The notification inbox. Only the owner reads or clears it.
      //
      // Likes and comments are posted by whoever caused them, so a client may
      // write into someone else's inbox — but only stamped with its own uid,
      // and only for those two types. Warnings and system updates are
      // therefore unforgeable from a client: they can only be written by the
      // Admin SDK, which bypasses these rules entirely.
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if signedIn()
                              && request.resource.data.actorUid == request.auth.uid
                              && request.resource.data.type in ['like', 'comment'];
      }

      // AI companion conversations.
      match /aiChats/{characterId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          // Clients may only append their own turns. Assistant turns are
          // written by the Cloud Function, so a client cannot forge model
          // output or poison the context sent to OpenAI.
          allow create: if isOwner(uid)
                        && request.resource.data.role == 'user';
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }

      // Tutor conversations, same split as aiChats.
      match /tutorSessions/{sessionId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
                        && request.resource.data.role == 'user';
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }
    }

    // Characters their authors chose to publish. Every signed-in account can
    // read the catalog to discover them; only the author can change or
    // withdraw their own entry. Private characters are never written here —
    // they stay in the author's own `aiCharacters` subcollection.
    match /publicAiCharacters/{characterId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn()
                            && resource.data.authorUid == request.auth.uid;
    }

    // Hall posts. Any signed-in user can like a post or add to its thread,
    // which is why update is not restricted to the author.
    match /posts/{postId} {
      allow read: if signedIn();

      // The sample posts seeded into an empty Hall carry a null authorUid,
      // so creation is not tied to the caller's uid.
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    // Direct human-to-human chats. Split per-operation because `resource` is
    // absent on create and `request.resource` is absent on read/delete.
    match /chats/{chatId} {

      function chatData() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data;
      }

      // Everyone who has written in this chat. The new list must keep every
      // uid the old one had and may add only the caller's own, so nobody can
      // fake a reply from the other side to unlock themselves, and nobody can
      // drop the other side to lock them out.
      function senderUidsUnforged() {
        return request.resource.data.get('senderUids', [])
                 .hasOnly(resource.data.get('senderUids', [])
                            .concat([request.auth.uid]))
               && resource.data.get('senderUids', [])
                    .hasOnly(request.resource.data.get('senderUids', []));
      }

      // True once the other participant has written at least once.
      function peerHasReplied() {
        return chatData().get('senderUids', [])
                 .hasAny(chatData().participantUids
                           .removeAll([request.auth.uid]));
      }

      allow read: if signedIn()
                  && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participantUids
                    && request.resource.data.get('senderUids', [])
                         .hasOnly([request.auth.uid]);
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participantUids
                    && request.auth.uid in request.resource.data.participantUids
                    && senderUidsUnforged();
      allow delete: if signedIn()
                    && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/chats/$(chatId))
                         .data.participantUids;

        // Until the other person writes back, an opening message must use the
        // fixed id `intro_<senderUid>`. Because messages can never be updated
        // or deleted, that id can only be claimed once — so an unanswered
        // sender is capped at exactly one message. Once the peer has replied,
        // ordinary auto-ids are accepted and the chat is unrestricted.
        allow create: if signedIn()
                      && request.resource.data.senderUid == request.auth.uid
                      && (
                           peerHasReplied()
                           || messageId == 'intro_' + request.auth.uid
                         );
        allow update, delete: if false;
      }
    }
  }
}
